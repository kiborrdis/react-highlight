{
  "name": "@brightgoose/react-highlight",
  "version": "0.1.4",
  "description": "A React highlighter library",
  "author": "kiborrdis",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/kiborrdis/react-highlight",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "verify": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn test:pw",
    "verify:ci": "yarn format:check && yarn lint && yarn typecheck && yarn test",
    "build": "vite build",
    "dev": "vite --config vite.dev.config.ts",
    "lint": "eslint ./src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pw": "playwright test -c playwright-ct.config.ts",
    "test:pw:update": "playwright test -c playwright-ct.config.ts --update-snapshots",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "yarn verify && yarn build"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-react": "^1.58.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "react",
    "highlighter",
    "highlight",
    "component"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.3.1"
}
